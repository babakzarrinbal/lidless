{
  "name": "lidless",
  "displayName": "Lidless",
  "description": "Opens Lidless shared terminals in VS Code: the chats you carried on to all devices, live and typeable here.",
  "version": "0.1.1",
  "publisher": "zarrinbal",
  "repository": "https://github.com/babakzarrinbal/lidless",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "lidless.attach", "title": "Open a shared terminal", "category": "Lidless" }
    ]
  }
}
