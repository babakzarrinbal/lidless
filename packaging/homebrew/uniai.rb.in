# Generated by ./dev.sh brew from packaging/homebrew/uniai.rb.in
class Uniai < Formula
  desc "Your Mac's terminals, files and Claude Code sessions on your phone"
  homepage "@HOMEPAGE@"
  version "@VERSION@"

  on_macos do
    on_arm do
      url "@URL_ARM@"
      sha256 "@SHA_ARM@"
    end
    on_intel do
      url "@URL_INTEL@"
      sha256 "@SHA_INTEL@"
    end
  end
  depends_on :macos

  def install
    bin.install "uniai"
  end

  service do
    run [opt_bin/"uniai", "serve"]
    keep_alive true
    process_type :interactive
    log_path var/"log/uniai.log"
    error_log_path var/"log/uniai.log"
  end

  def caveats
    <<~EOS
      Point it at your relay; this starts it (now and at every login)
      and shows a code to scan with the bz-uniai app:
        uniai setup your.server:8460

      It shows the relay's certificate pin to compare with
      `docker exec uniai-relay /relay pin` on the server
      (or pass it: -pin <sha256>). More phones later: uniai pair.

      Installed it before with install.sh? Run `uniai uninstall` first,
      so only one copy runs (your paired phones are kept).
    EOS
  end

  test do
    assert_match "usage: uniai", shell_output("#{bin}/uniai 2>&1", 2)
  end
end
