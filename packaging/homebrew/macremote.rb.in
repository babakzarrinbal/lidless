# Generated by ./dev.sh brew from packaging/homebrew/macremote.rb.in
class Macremote < Formula
  desc "Your Mac's terminals, files and Claude Code sessions on your phone"
  homepage "https://github.com/OWNER/homebrew-macremote"
  version "@VERSION@"

  on_macos do
    on_arm do
      url "@URL_ARM@"
      sha256 "@SHA_ARM@"
    end
    on_intel do
      url "@URL_INTEL@"
      sha256 "@SHA_INTEL@"
    end
  end
  depends_on :macos

  def install
    bin.install "macremote"
  end

  service do
    run [opt_bin/"macremote", "serve"]
    keep_alive true
    process_type :interactive
    log_path var/"log/macremote.log"
    error_log_path var/"log/macremote.log"
  end

  def caveats
    <<~EOS
      Run it now and at every login:
        brew services start macremote
      Then pair your phone: run `macremote pair` and scan the code
      with the Mac Remote app.

      Installed it before with install.sh? Run `macremote uninstall` first,
      so only one copy runs (your paired phones are kept).
    EOS
  end

  test do
    assert_match "usage: macremote", shell_output("#{bin}/macremote 2>&1", 2)
  end
end
